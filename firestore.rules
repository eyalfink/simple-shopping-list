rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user belongs to the household
    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/household_members/$(request.auth.uid + '_' + householdId));
    }

    // Rules for shopping lists
    match /lists/{listId} {
      allow read, write: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create: if isAuthenticated();
    }

    // Rules for household members
    match /household_members/{membershipId} {
      allow read, write: if isAuthenticated();
    }

    // Rules for shopping list items
    match /items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Rules for product history
    match /product_history/{productId} {
      allow read, write: if isAuthenticated();
    }
  }
}
